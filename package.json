{
  "name": "zerobin-cloudflare",
  "version": "1.0.0",
  "private": true,
  "description": "ZeroBin - zero-knowledge encrypted pastebin on Cloudflare Workers",
  "scripts": {
    "postinstall": "cd frontend && npm install",
    "dev": "wrangler dev --local",
    "build": "cd frontend && npm run build",
    "build:check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "deploy": "npm run build && npm run db:migrate:prod && wrangler deploy",
    "deploy:preview": "npm run build && wrangler deploy --env preview",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:prod": "wrangler d1 migrations apply DB --remote"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.16.9",
    "@cloudflare/workers-types": "^4.20241218.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.0",
    "wrangler": "^4.94.0"
  }
}
